<div class="tasks-page">
  <div class="task-page-header">
    <h1><%= @the_task.task_title %></h1>

    <div class="task-page-actions">
      <a href="/" class="task-page-link">Go back</a>
      <a
        href="/delete_task/<%= @the_task.id %>"
        class="danger-link task-page-link"
        onclick="return confirm('Are you sure you want to delete this task?')"
      >
        Delete task
      </a>
    </div>
  </div>

  <div class="task-form-card">
    <article>
      <header>
        <h2>
          Edit task
        </h2>
      </header>

      <form action="/modify_task/<%= @the_task.id %>" method="post" class="task-form">
        <div class="task-form-row">
          <label for="course_id_box">
            Course
          </label>

          <select id="course_id_box" name="query_course_id">
            <option value="">-- No Course --</option>

            <% current_user.courses.each do |course| %>
              <option value="<%= course.id %>" <%= "selected" if course.id == @the_task.course_id %>>
                <%= course.name %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="task-form-row">
          <label for="task_title_box">
            Task title
          </label>

          <input type="text" id="task_title_box" name="query_task_title" value="<%= @the_task.task_title %>">
        </div>

        <div class="task-form-row">
          <label for="description_box">
            Description
          </label>

          <input type="text" id="description_box" name="query_description" value="<%= @the_task.description %>">
        </div>

        <div class="task-form-row">
          <label for="due_date_box">
            Due date
          </label>

          <input type="date" id="due_date_box" name="query_due_date" value="<%= @the_task.due_date %>">
        </div>

        <div class="task-form-row">
          <label for="due_time_box">
            Due time
          </label>

          <input type="time" id="due_time_box" name="query_due_time" value="<%= @the_task.due_time&.strftime("%H:%M") %>">
        </div>

        <div class="task-form-row">
          <label for="priority_rank_box">
            Priority
          </label>

          <select id="priority_rank_box" name="query_priority_rank">
            <option value="1" <%= "selected" if @the_task.priority_rank == 1 %>>Low</option>
            <option value="2" <%= "selected" if @the_task.priority_rank == 2 %>>Medium</option>
            <option value="3" <%= "selected" if @the_task.priority_rank == 3 %>>High</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="exam_flag_box">
            Exam?
          </label>

          <select id="exam_flag_box" name="query_exam_flag">
            <option value="0" <%= "selected" if @the_task.exam_flag == 0 %>>No</option>
            <option value="1" <%= "selected" if @the_task.exam_flag == 1 %>>Yes</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="optional_flag_box">
            Optional task
          </label>

          <select id="optional_flag_box" name="query_optional_flag">
            <option value="0" <%= "selected" if @the_task.optional_flag == 0 %>>No</option>
            <option value="1" <%= "selected" if @the_task.optional_flag == 1 %>>Yes</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="status_box">
            Status
          </label>

          <select id="status_box" name="query_status">
            <option value="not_started" <%= "selected" if @the_task.status == "not_started" %>>Not Started</option>
            <option value="in_progress" <%= "selected" if @the_task.status == "in_progress" %>>In Progress</option>
            <option value="completed" <%= "selected" if @the_task.status == "completed" %>>Completed</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="weight_perc_box">
            Weight %
          </label>

          <input type="text" id="weight_perc_box" name="query_weight_perc" value="<%= @the_task.weight_perc %>">
        </div>

        <button type="submit" class="task-submit-button">
          Update task
        </button>
      </form>
    </article>
  </div>
</div>

<hr>
