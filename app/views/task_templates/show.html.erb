<h1>
  Task #<%= @the_task.id %> details
</h1>

<article>
  <div>
    <a href="/tasks">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_task/<%= @the_task.id %>">
      Delete task
    </a>
  </div>
  <dl>
    <dt>
      Course
    </dt>
    <dd>
      <%= @the_task.course_id %>
    </dd>

    <dt>
      Exam flag
    </dt>
    <dd>
      <%= @the_task.exam_flag %>
    </dd>

    <dt>
      Due date
    </dt>
    <dd>
      <%= @the_task.due_date %>
    </dd>

    <dt>
      Optional flag
    </dt>
    <dd>
      <%= @the_task.optional_flag %>
    </dd>

    <dt>
      Priority rank
    </dt>
    <dd>
      <%= @the_task.priority_rank %>
    </dd>

    <dt>
      User
    </dt>
    <dd>
      <%= @the_task.user_id %>
    </dd>

    <dt>
      Status
    </dt>
    <dd>
      <%= @the_task.status %>
    </dd>

    <dt>
      Description
    </dt>
    <dd>
      <%= @the_task.description %>
    </dd>

    <dt>
      Due time
    </dt>
    <dd>
      <%= @the_task.due_time %>
    </dd>

    <dt>
      Weight perc
    </dt>
    <dd>
      <%= @the_task.weight_perc %>
    </dd>

    <dt>
      Task title
    </dt>
    <dd>
      <%= @the_task.task_title %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_task.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_task.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit task
    </h2>
  </header>

  <form action="/modify_task/<%= @the_task.id %>"  method="post" >
    <div>
      <label for="course_id_box">
        Course
      </label>

      <input type="text" id="course_id_box" name="query_course_id" value="<%= @the_task.course_id %>">
    </div>

    <div>
      <label for="exam_flag_box">
        Exam flag
      </label>

      <input type="text" id="exam_flag_box" name="query_exam_flag" value="<%= @the_task.exam_flag %>">
    </div>

    <div>
      <label for="due_date_box">
        Due date
      </label>

      <input type="date" id="due_date_box" name="query_due_date" value="<%= @the_task.due_date %>">
    </div>

    <div>
      <label for="optional_flag_box">
        Optional flag
      </label>

      <input type="text" id="optional_flag_box" name="query_optional_flag" value="<%= @the_task.optional_flag %>">
    </div>

    <div>
      <label for="priority_rank_box">
        Priority rank
      </label>

      <input type="text" id="priority_rank_box" name="query_priority_rank" value="<%= @the_task.priority_rank %>">
    </div>

    <div>
      <label for="user_id_box">
        User
      </label>

      <input type="text" id="user_id_box" name="query_user_id" value="<%= @the_task.user_id %>">
    </div>

    <div>
      <label for="status_box">
        Status
      </label>

      <input type="text" id="status_box" name="query_status" value="<%= @the_task.status %>">
    </div>

    <div>
      <label for="description_box">
        Description
      </label>

      <input type="text" id="description_box" name="query_description" value="<%= @the_task.description %>">
    </div>

    <div>
      <label for="due_time_box">
        Due time
      </label>

      <input type="time" id="due_time_box" name="query_due_time" value="<%= @the_task.due_time %>">
    </div>

    <div>
      <label for="weight_perc_box">
        Weight perc
      </label>

      <input type="text" id="weight_perc_box" name="query_weight_perc" value="<%= @the_task.weight_perc %>">
    </div>

    <div>
      <label for="task_title_box">
        Task title
      </label>

      <input type="text" id="task_title_box" name="query_task_title" value="<%= @the_task.task_title %>">
    </div>

    <button type="submit">
      Update task
    </button>
  </form>
</article>

<hr>
