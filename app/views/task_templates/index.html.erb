<div class="tasks-page">
  <div class="task-form-card">
    <article>
      <header>
        <h2>
          Add a new task
        </h2>
      </header>

      <form action="/insert_task" method="post" class="task-form">
        <div class="task-form-row">
          <label for="course_id_box">
            Course
          </label>

          <select id="course_id_box" name="query_course_id">
            <option value="">-- No Course --</option>

            <% Course.all.each do |course| %>
              <option value="<%= course.id %>">
                <%= course.name %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="task-form-row">
          <label for="task_title_box">
            Task Title
          </label>

          <input type="text" id="task_title_box" name="query_task_title">
        </div>

        <div class="task-form-row">
          <label for="description_box">
            Description
          </label>

          <input type="text" id="description_box" name="query_description">
        </div>

        <div class="task-form-row">
          <label for="due_date_box">
            Due Date
          </label>

          <input type="date" id="due_date_box" name="query_due_date">
        </div>

        <div class="task-form-row">
          <label for="due_time_box">
            Due Time
          </label>

          <input type="time" id="due_time_box" name="query_due_time">
        </div>

        <div class="task-form-row">
          <label for="priority_rank_box">
            Priority
          </label>

          <select id="priority_rank_box" name="query_priority_rank">
            <option value="1">Low</option>
            <option value="2">Medium</option>
            <option value="3">High</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="exam_flag_box">
            Exam?
          </label>

          <select id="exam_flag_box" name="query_exam_flag">
            <option value="0">No</option>
            <option value="1">Yes</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="optional_flag_box">
            Optional Task
          </label>

          <select id="optional_flag_box" name="query_optional_flag">
            <option value="0">No</option>
            <option value="1">Yes</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="status_box">
            Status
          </label>

          <select id="status_box" name="query_status">
            <option value="not_started">Not Started</option>
            <option value="in_progress">In Progress</option>
            <option value="completed">Completed</option>
          </select>
        </div>

        <div class="task-form-row">
          <label for="weight_perc_box">
            Weight %
          </label>

          <input type="text" id="weight_perc_box" name="query_weight_perc" placeholder="25">
        </div>

        <button type="submit" class="task-submit-button">
          Create task
        </button>
      </form>
    </article>
  </div>
</div>
