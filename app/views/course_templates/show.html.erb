<h1>
  <%= @the_course.name %>
</h1>

<div>
  <a href="/courses">
    Go back
  </a>
</div>

<div>
  <a href="/delete_course/<%= @the_course.id %>">
    Delete course
  </a>
</div>

<hr>

<article>
  <header>
    <h2>
      Edit Course Information
    </h2>
  </header>

  <form action="/modify_course/<%= @the_course.id %>" method="post">
    <div>
      <label for="name_box">
        Name
      </label>

      <input type="text" id="name_box" name="query_name" value="<%= @the_course.name %>">
    </div>

    <div>
      <label for="user_id_box">
        User
      </label>

      <input type="text" id="user_id_box" name="query_user_id" value="<%= @the_course.user_id %>">
    </div>

    <div>
      <label for="location_box">
        Location
      </label>

      <input type="text" id="location_box" name="query_location" value="<%= @the_course.location %>">
    </div>

    <div>
      <label for="meeting_time_box">
        Meeting time
      </label>

      <input type="time" id="meeting_time_box" name="query_meeting_time" value="<%= @the_course.meeting_time&.strftime("%H:%M") %>">
    </div>

    <div>
      <label for="start_date_box">
        Course Start Date
      </label>

      <input type="date" id="start_date_box" name="query_start_date" value="<%= @the_course.start_date %>">
    </div>

    <div>
      <label for="end_date_box">
        Course End Date
      </label>

      <input type="date" id="end_date_box" name="query_end_date" value="<%= @the_course.end_date %>">
    </div>

    <div>
      <label for="instructor_name_box">
        Instructor name
      </label>

      <input type="text" id="instructor_name_box" name="query_instructor_name" value="<%= @the_course.instructor_name %>">
    </div>

    <div>
      <label for="instructor_email_box">
        Instructor email
      </label>

      <input type="text" id="instructor_email_box" name="query_instructor_email" value="<%= @the_course.instructor_email %>">
    </div>

    <div>
      <label for="color_box">
        Color
      </label>

      <input type="color" id="color_box" name="query_color" value="<%= @the_course.color.presence || "#4F46E5" %>">
    </div>

    <div>
      <label>
        Meeting days
      </label>

      <% selected_days = (@the_course.meeting_days || "").split(",").map(&:strip) %>

      <% ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"].each do |day| %>
        <div>
          <input
            type="checkbox"
            id="<%= day.downcase %>_box"
            name="query_meeting_days[]"
            value="<%= day %>"
            <%= "checked" if selected_days.include?(day) %>
          >
          <label for="<%= day.downcase %>_box"><%= day %></label>
        </div>
      <% end %>
    </div>

    <button type="submit">
      Update course
    </button>
  </form>
</article>

<hr>

<div class="task-list-box">
  <h2>Tasks for this course</h2>
  <h4>
    <a href="/tasks">Add new task</a>
  </h4>

  <div class="task-scroll-area">
    <div class="task-header-row">
      <div></div>
      <div>Task</div>
      <div>Due Date</div>
      <div>Priority</div>
      <div></div>
    </div>

    <% @upcoming_tasks.each do |task| %>
      <div class="task-row">
        <div>
          <form action="/mark_task_complete/<%= task.id %>" method="post">
            <input type="hidden" name="query_completed" value="0">

            <input
              type="checkbox"
              name="query_completed"
              value="1"
              class="task-checkbox"
              <%= "checked" if task.status == "completed" %>
              onchange="this.form.submit();"
            >
          </form>
        </div>

        <div class="task-info">
          <div class="task-title">
            <%= task.task_title %>
          </div>

          <div class="task-meta">
            <%= task.course.name if task.course.present? %>
          </div>
        </div>

        <div class="task-due-date">
          <%= task.due_date.present? ? task.due_date : "—" %>
        </div>

        <div class="task-priority">
          <% if task.priority_rank.present? %>
            <% priority_label =
              case task.priority_rank
              when 1 then "High"
              when 2 then "Medium"
              when 3 then "Low"
              else task.priority_rank
              end
            %>
            <%= priority_label %>
          <% else %>
            —
          <% end %>
        </div>

        <div class="task-link-cell">
          <a href="/tasks/<%= task.id %>">Edit/View Details</a>
        </div>
      </div>
    <% end %>
  </div>
</div>

