<h1>Homework Tracker</h1>

<div class="task-list-box">
  <h2>Upcoming Tasks</h2>

<div style="margin-bottom: 12px;">
  <form action="/" method="get">
    <label for="sort_box">Order by:</label>

    <select id="sort_box" name="sort" onchange="this.form.submit();">
      <option value="due_date" <%= "selected" if @selected_sort == "due_date" %>>
        Earliest Due Date
      </option>
      <option value="course" <%= "selected" if @selected_sort == "course" %>>
        Course
      </option>
      <option value="priority" <%= "selected" if @selected_sort == "priority" %>>
        Priority
      </option>
    </select>
  </form>
</div>

  <div class="task-scroll-area">
    <% @upcoming_tasks.each do |task| %>
      <div class="task-row">
        <div class="task-left">
          <form action="/mark_task_complete/<%= task.id %>" method="post">
            <input type="hidden" name="query_completed" value="0">

            <input
              type="checkbox"
              name="query_completed"
              value="1"
              class="task-checkbox"
              <%= "checked" if task.status == "completed" %>
              onchange="this.form.submit();"
            >
          </form>

          <div class="task-info">
            <div class="task-title">
              <%= task.task_title %>
            </div>

            <div class="task-meta">
              <%= task.course.name if task.course.present? %>
              <% if task.due_date.present? %>
                · Due <%= task.due_date %>
              <% end %>
            </div>
          </div>
        </div>

        <a href="/tasks/<%= task.id %>">Edit</a>
      </div>
    <% end %>
  </div>
</div>

<details class="completed-box">
  <summary>Completed Tasks (<%= @completed_tasks.count %>)</summary>

  <div class="task-scroll-area">
    <% @completed_tasks.each do |task| %>
      <div class="task-row task-completed">
        <div class="task-left">
          <form action="/mark_task_complete/<%= task.id %>" method="post">
            <input type="hidden" name="query_completed" value="0">

            <input
              type="checkbox"
              name="query_completed"
              value="1"
              class="task-checkbox"
              checked
              onchange="this.form.submit();"
            >
          </form>

          <div class="task-info">
            <div class="task-title">
              <%= task.task_title %>
            </div>

            <div class="task-meta">
              <%= task.course.name if task.course.present? %>
              <% if task.due_date.present? %>
                · Due <%= task.due_date %>
              <% end %>
            </div>
          </div>
        </div>

        <a href="/tasks/<%= task.id %>">View</a>
      </div>
    <% end %>
  </div>
</details>
