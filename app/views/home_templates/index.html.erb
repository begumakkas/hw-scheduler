<h1>Homework Productivity Tracker</h1>

<div class="task-list-box">
  <h2>Upcoming Tasks</h2>

  <div class="task-scroll-area">
    <% @tasks.each do |task| %>
      <div class="task-row">
        <div class="task-left">
          <input
            type="checkbox"
            class="task-checkbox"
            <%= "checked" if task.status == "completed" %>
          >

          <div class="task-info">
            <div class="task-title">
              <%= task.task_title %>
            </div>

            <div class="task-meta">
              <%= task.course.name if task.course.present? %>
              <% if task.due_date.present? %>
                · Due <%= task.due_date %>
              <% end %>
            </div>
          </div>
        </div>

        <a href="/tasks/<%= task.id %>">View</a>
      </div>
    <% end %>
  </div>
</div>
