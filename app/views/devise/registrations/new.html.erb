<div class="auth-page">
  <div class="auth-card">
    <h2>Sign up</h2>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= f.error_notification %>

      <div class="auth-form-row">
        <%= f.input :email,
                    label_html: { class: "auth-label" },
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email", class: "auth-input" } %>
      </div>

      <div class="auth-form-row">
        <%= f.input :password,
                    label_html: { class: "auth-label" },
                    required: true,
                    hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                    input_html: { autocomplete: "new-password", class: "auth-input" } %>
      </div>

      <div class="auth-form-row">
        <%= f.input :password_confirmation,
                    label_html: { class: "auth-label" },
                    required: true,
                    input_html: { autocomplete: "new-password", class: "auth-input" } %>
      </div>

      <div class="auth-form-actions">
        <%= f.button :submit, "Sign up", class: "auth-button" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
