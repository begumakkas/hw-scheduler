<h1>
  Upload Syllabus
</h1>

<h3>It may take a few seconds after you upload a syllabus for the parsing to complete. Do not refresh the page while this process is running.</h3>


<form action="/upload_syllabus" method="post" enctype="multipart/form-data">
  <div>
    <label for="pdf_box">
      Syllabus PDF
    </label>

    <input type="file" id="pdf_box" name="pdf" accept=".pdf,application/pdf">
  </div>

  <button type="submit">
    Upload syllabus
  </button>
</form>


